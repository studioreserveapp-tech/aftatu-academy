# Brevo (contacts, email, SMS). Never prefix these with NEXT_PUBLIC_.
BREVO_API_KEY=
# Numeric list ID from Contacts → Lists. Suggested name: Aftatu Academy · Beginner course
BREVO_LIST_ID=
# US country code. 10-digit numbers become +1XXXXXXXXXX.
BREVO_DEFAULT_COUNTRY_CODE=1
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Aftatu Academy
BREVO_NOTIFY_EMAIL=

# Optional: replace the hero with studio footage.
# NEXT_PUBLIC_HERO_VIDEO_URL=/media/hero.mp4
